# Copy this file to .env.local for local runs or .env.dev for deployed-dev smoke.
# Keep real credentials out of the repository.

E2E_USER_USERNAME=replace-me
E2E_USER_PASSWORD=replace-me
E2E_ADMIN_USERNAME=replace-me
E2E_ADMIN_PASSWORD=replace-me
E2E_BASE_URL=http://localhost:3000

# Optional flags used by the test harness.
E2E_DEV_SMOKE_INFO_HASH=
E2E_INCLUDE_MANUAL_TORRENT_TESTS=0
E2E_FORCE_STACK_RESTART=0
E2E_REQUIRE_HTTP_TORRENT_PROVIDER=0
DEV_SMOKE_COMMIT_SHA=
