# Required
MONGODB_URI=mongodb://127.0.0.1:27017/mymediavault
OPENAI_API_KEY=

# Optional database settings.
MMV_MONGODB_DB_NAME=mymediavault
MMV_MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Required for deployed shared storage. Set R2_ENDPOINT, R2_ACCESS_KEY_ID, and
# R2_SECRET_ACCESS_KEY together to use Cloudflare R2. For local-only runs, leave
# them blank to use filesystem blob storage under .local/blob-storage.
# R2_BUCKET_NAME defaults to torrent-raw when unset.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=torrent-raw

# Optional VM worker tuning.
MMV_PREVIEW_WORKER_ENABLED=true
MMV_ACTOR_ANALYSIS_WORKER_ENABLED=true
MMV_ACTOR_ANALYSIS_MODELS_DIR=.local/models
MMV_ACTOR_ANALYSIS_POLL_INTERVAL_SECONDS=5
MMV_ACTOR_ANALYSIS_LEASE_SECONDS=1800
MMV_ACTOR_ANALYSIS_MAX_ATTEMPTS=3
MMV_PREVIEW_WORKER_MAX_CONCURRENCY=20
MMV_PREVIEW_WORKER_POLL_INTERVAL_SECONDS=5
MMV_PREVIEW_REPAIR_STALE_PROCESSING_MINUTES=120
MMV_PREVIEW_EXTRACT_FRAMES_PER_ANCHOR=7
MMV_PREVIEW_MIN_SELECTOR_CANDIDATES_PER_ANCHOR=2
MMV_PREVIEW_MAX_SELECTOR_CANDIDATES_PER_ANCHOR=4
MMV_PREVIEW_ANCHOR_RETRY_RANGE_MB=[64,128,256,384,512,768]
MMV_PREVIEW_DOWNLOAD_PROGRESS_TIMEOUT_SECONDS=300
MMV_PREVIEW_SESSION_FAIRNESS_SECONDS=7200
MMV_PREVIEW_FAILURE_LIMIT=3
MMV_PREVIEW_EXTERNAL_FAILURE_COOLDOWN_SECONDS=300
MMV_PREVIEW_CACHE_DIR=/var/cache/mymediavault/vm-worker
MMV_PREVIEW_CACHE_MAX_MB=32768

# VM worker logging. Console logs stay at INFO; DEBUG logs are always written as
# rotated JSON Lines for diagnosis.
MMV_VM_WORKER_DEBUG_LOG_PATH=.local/logs/vm-worker-debug.log
MMV_VM_WORKER_DEBUG_LOG_ROTATION="100 MB"
MMV_VM_WORKER_DEBUG_LOG_RETENTION="7 days"

# Optional torrent metadata resolution tuning.
MMV_TORRENT_PROVIDER=http
MMV_TORRENT_RESOLVER_URLS='["https://itorrents.org/torrent/{info_hash}.torrent"]'
MMV_TORRENT_FETCH_TIMEOUT_SECONDS=20
MMV_TORRENT_DHT_FALLBACK_ENABLED=true
MMV_TORRENT_DHT_TIMEOUT_SECONDS=600
