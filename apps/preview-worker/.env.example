MONGODB_URI=mongodb://127.0.0.1:27017/mymediavault
MMV_MONGODB_DB_NAME=mymediavault
MMV_MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Set all three R2 values to use Cloudflare R2. Leave them blank for local
# filesystem blob storage under .local/blob-storage.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=torrent-raw

OPENAI_API_KEY=
MMV_PREVIEW_WORKER_MAX_CONCURRENCY=20
MMV_PREVIEW_WORKER_POLL_INTERVAL_SECONDS=5
MMV_PREVIEW_REPAIR_STALE_PROCESSING_MINUTES=120
MMV_PREVIEW_MAX_ATTEMPTS=3
