# MongoDB connection settings
MONGODB_URI=mongodb://127.0.0.1:27017/mymediavault
MMV_MONGODB_DB_NAME=mymediavault

# Authentication
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_MICROSOFT_ENTRA_ID_ID=your-entra-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=your-entra-client-secret
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0
MMV_ADMIN_OBJECT_IDS=[]
MMV_ADMIN_GROUP_OBJECT_IDS=[]

# Cloudflare R2 for torrent raw file storage
R2_ENDPOINT=https://example.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=torrent-raw
