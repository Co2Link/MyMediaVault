{
  "name": "@mymediavault/core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js",
      "default": "./dist/db.js"
    },
    "./auth-adapter": {
      "types": "./dist/auth-adapter.d.ts",
      "import": "./dist/auth-adapter.js",
      "default": "./dist/auth-adapter.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js",
      "default": "./dist/storage.js"
    },
    "./tags": {
      "types": "./dist/tags.d.ts",
      "import": "./dist/tags.js",
      "default": "./dist/tags.js"
    },
    "./torrent-provider": {
      "types": "./dist/torrent-provider.d.ts",
      "import": "./dist/torrent-provider.js",
      "default": "./dist/torrent-provider.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js",
      "default": "./dist/validation.js"
    },
    "./videos": {
      "types": "./dist/videos.d.ts",
      "import": "./dist/videos.js",
      "default": "./dist/videos.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "db:init": "node dist/db.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth/core": "^0.41.0",
    "@aws-sdk/client-s3": "^3.850.0",
    "bencode": "^4.0.0",
    "mongoose": "^8.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bencode": "^2.0.4",
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
