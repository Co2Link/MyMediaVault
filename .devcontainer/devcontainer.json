{
	"name": "Existing Docker Compose (Extend)",
	"dockerComposeFile": [
		"docker-compose.yml"
	],
	"service": "devcontainer",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"features": {
		"ghcr.io/va-h/devcontainers-features/uv:1": {},
		"ghcr.io/devcontainers-extra/features/terraform-asdf:2": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"moby": false
		},
		"ghcr.io/devcontainers/features/node:2": {
			"version": "22"
		}
	},
	"containerEnv":{
		"R2_ENDPOINT": "${localEnv:R2_ENDPOINT}",
		"R2_ACCESS_KEY_ID": "${localEnv:R2_ACCESS_KEY_ID}",
		"R2_SECRET_ACCESS_KEY": "${localEnv:R2_SECRET_ACCESS_KEY}",
		"OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
		"UV_INDEX_LINGXT_USERNAME": "az",
		"UV_INDEX_LINGXT_PASSWORD": "${localEnv:UV_INDEX_LINGXT_PASSWORD}",
		"GH_TOKEN": "${localEnv:GH_TOKEN}"
	},
	"postCreateCommand": "bash .devcontainer/post-create.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"bierner.markdown-mermaid",
				"charliermarsh.ruff",
				"mongodb.mongodb-vscode",
				"lvdn.s3x-explorer",
				"ritwickdey.liveserver",
				"astral-sh.ty"
			]
		}
	}
}
