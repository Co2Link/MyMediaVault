#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

run_in() {
  local dir="$1"
  shift
  printf '\n[%s] %s\n' "$dir" "$*"
  (cd "$repo_root/$dir" && "$@")
}

has_staged_changes_in() {
  local prefix="$1"
  grep -qE "^${prefix}(/|$)" <<<"$staged_files"
}

skip_section() {
  local label="$1"
  printf '\n[skip] %s\n' "$label"
}

if has_staged_changes_in "packages/core"; then
  run_in packages/core npm run build
  run_in packages/core npm run test
else
  skip_section "core checks"
fi

if has_staged_changes_in "apps/web" || has_staged_changes_in "packages/core"; then
  run_in apps/web npm run build
  run_in apps/web npm run test
else
  skip_section "web checks"
fi

if has_staged_changes_in "apps/vm-worker"; then
  run_in apps/vm-worker uv sync --locked
  run_in apps/vm-worker uv run pytest
else
  skip_section "VM worker checks"
fi

if has_staged_changes_in "infra/terraform"; then
  run_in infra/terraform/envs/dev terraform fmt -check -recursive ../..
  run_in infra/terraform/envs/dev terraform init -backend=false
  run_in infra/terraform/envs/dev terraform validate
else
  skip_section "terraform checks"
fi
